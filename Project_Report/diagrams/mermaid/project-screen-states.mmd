State <|-- GameOverState
MainMenuState ..> ContinuePromptState : continue save
MainMenuState ..> TransitionState : new game
TransitionState ..> PlayingState : begin / resume
PlayingState ..> PausedState : pause
PlayingState ..> VictoryState : goal reached
PlayingState ..> GameOverState : lives exhausted
VictoryState ..> TransitionState : next level
