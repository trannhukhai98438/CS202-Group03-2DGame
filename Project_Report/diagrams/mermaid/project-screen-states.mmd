classDiagram
direction TB
class State {
  <<abstract>>
  +processEvents(event)
  +update(dt)
  +render(window)
  +rendersBelow() bool
}
class Game {
  <<Singleton>>
  -stateStack
  +pushState(state)
  +popState()
  +changeState(state)
}
class MainMenuState
class ContinuePromptState { +rendersBelow() bool }
class CharacterSelectState
class LevelSelectState
class GuideState
class SettingsState
class TransitionState
class PlayingState
class PausedState { +rendersBelow() bool }
class VictoryState { +rendersBelow() bool }
class GameOverState

Game "1" o-- "many" State : owns
